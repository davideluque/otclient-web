{
  "name": "otclient-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ proxy/",
    "typecheck:proxy": "tsc -p proxy/tsconfig.json",
    "audit:ci": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "proxy": "npx tsx proxy/server.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "ws": "^8.21.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "$ws",
    "brace-expansion": "5.0.6"
  }
}

{
  "name": "otclient-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ proxy/",
    "typecheck:proxy": "tsc -p proxy/tsconfig.json",
    "audit:ci": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:e2e": "playwright test --config scripts/playwright.config.mjs",
    "test:watch": "vitest",
    "proxy": "npx tsx proxy/server.ts",
    "proxy:jamera": "OT_GAME_PORT=7171 npx tsx proxy/server.ts",
    "tv:build": "tsc && vite build --config vite.tv.config.ts --mode tv && node scripts/tv-bundle.mjs",
    "tv:check": "node scripts/tv-bundle.mjs --check",
    "tv:smoke": "npm run tv:build && TV_SMOKE=1 npm run test:e2e",
    "tv:package": "node scripts/tv.mjs package",
    "tv:install": "node scripts/tv.mjs install",
    "tv:launch": "node scripts/tv.mjs launch",
    "tv:inspect": "node scripts/tv.mjs inspect",
    "tv:serve": "node scripts/tv.mjs serve",
    "tv:deploy": "node scripts/tv.mjs deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "pixi.js": "^8.23.0",
    "ws": "^8.23.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "$ws",
    "brace-expansion": "5.0.13"
  }
}
